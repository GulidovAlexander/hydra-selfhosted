# ---------------------------------------------------------------------------
# Copy to .env and fill in.   Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# Shared secret handed to every launcher client (Settings -> Integrations).
# NOTE: the API also uses this value as its JWT signing key, so anyone holding
# it can mint a session token for any account on this server. Treat it as an
# admin credential, not as a "join code".
API_TOKEN=

# Guards /admin/* (list/create/edit/delete users) and /auth/verify-instance.
# If this is empty the admin routes accept unauthenticated requests. Must be
# DIFFERENT from API_TOKEN, and must not be given to clients.
INSTANCE_TOKEN=

# Where the published port is bound on the host.
#   127.0.0.1  -> this machine only (default)
#   0.0.0.0    -> every interface
#   192.168.x.y-> just your LAN NIC (preferred once other devices join)
BIND_ADDR=127.0.0.1
PORT=3000

# Launcher session duration in days.
SESSION_TTL_DAYS=30

# Public URL shown in the web dashboard.
PUBLIC_URL=http://localhost:3000

# Max cloud-save upload size in MB.
MAX_SAVE_SIZE_MB=50

# Username promoted to admin on first run. Leave empty and the first account
# created gets admin automatically.
INITIAL_ADMIN_USERNAME=

# Allowed browser origins, comma separated. Leaving this EMPTY makes the API
# reflect whatever Origin asks, which lets any web page your browser visits
# call this API with credentials. Always fill it in.
CORS_ORIGINS=http://localhost:3000

# --- passkeys (WebAuthn) ---------------------------------------------------
# Only work over https:// or on localhost. RP_ID is a bare host, ORIGIN is a
# full origin, and they must match how the browser actually reaches the server.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# --- optional: `docker compose --profile https up -d` ----------------------
HTTPS_PORT=8443
SERVER_NAME=localhost
